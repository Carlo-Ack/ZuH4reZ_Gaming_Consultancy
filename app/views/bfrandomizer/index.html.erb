<h1>Welcome to the Battlefield6 Randomizer:</h1>

<h2>Watch history:</h2>
<div class="bfrandomizercardcontainer">

<%# not clickable atm %>
  <% @bfrandomizer_history.each do |bfrandomizer| %>
    <div class="bfrandomizer-card">
      <h2><%= bfrandomizer.name %></h2>
    </div>
  <% end %>

</div>

<div class="bfrandomizerroll">
 <%= link_to "Roll the dice", new_bfrandomizer_path, class: "btn btn-outline-primary btn-sm", style: "border-radius:12px;" %>
</div>
