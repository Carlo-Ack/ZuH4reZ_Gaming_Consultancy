<h1>Welcome to the Battlefield6 Randomizer:</h1>
<h2>Watch history:</h2>
<div class="bfrandomizercardcontainer">

<%# not clickable atm %>
  <% @bfrandomizer_history.each do |bfrandomizer| %>
    <div class="bfrandomizer-card">
      <h2><%= bfrandomizer.name%>, <%= bfrandomizer.created_at%></h2>
    </div>
  <% end %>
</div>

<turbo-frame id="randomizer_result">
  <%= render "random_result" %>
</turbo-frame>

<div class="bfrandomizerroll">
 <%= link_to "Roll the dice",
  roll_bfrandomizers_path,
  class: "btn btn-outline-primary btn-sm", style: "border-radius:12px;" %>
</div>
